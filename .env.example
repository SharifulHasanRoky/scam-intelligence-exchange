# ============================================================================
# Scam Intelligence Exchange — environment variables
# ============================================================================
# Copy this file to `.env.local` (development) or set these in your Vercel
# project settings (production). NEVER commit real secrets to git.
# ============================================================================

# --- Gemini AI -------------------------------------------------------------
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model identifier. Recommended: gemini-2.5-flash (fast, cheap) or gemini-2.5-pro.
GEMINI_MODEL=gemini-2.5-flash

# --- GitHub public repository (approved reports + search indexes) ----------
# The repository that stores approved reports as JSON files.
# Token scope needed: `repo` (or fine-grained: Contents RW on this repo).
GITHUB_PUBLIC_OWNER=
GITHUB_PUBLIC_REPO=scam-intelligence-exchange
GITHUB_PUBLIC_TOKEN=

# --- GitHub private moderation repository (pending report issues) ----------
# A SEPARATE private repository that stores pending submissions as Issues.
# Token scope needed: `repo` (or fine-grained: Issues RW on this repo).
GITHUB_PRIVATE_OWNER=
GITHUB_PRIVATE_REPO=scam-intelligence-private
GITHUB_PRIVATE_TOKEN=

# --- Application ----------------------------------------------------------
# Public canonical URL of the deployed site (no trailing slash).
NEXT_PUBLIC_APP_URL=https://your-domain.example
APP_URL=https://your-domain.example

# --- Admin access ---------------------------------------------------------
# Comma-separated list of admin emails (reserved for future multi-admin).
ADMIN_EMAILS=
# Single shared admin secret for the MVP. Use a long random string (>=32 chars).
# Generate with: openssl rand -hex 32
ADMIN_SECRET=

# --- Security -------------------------------------------------------------
# Secret used for HMAC-hashing identifiers and signing rate-limit buckets.
# Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=
# Secret used to HMAC-hash identifiers before they are stored publicly.
# NEVER change this after launch — doing so breaks all existing matches.
IDENTIFIER_HMAC_SECRET=

# --- Advertising (optional, after AdSense approval) -----------------------
# Google AdSense client id, e.g. ca-pub-1234567890123456
# Leave empty in development; ads render as labelled placeholders.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Slot IDs for the two allowed placements.
NEXT_PUBLIC_ADSENSE_SLOT_HOMEPAGE=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE=

# --- Analytics (optional, privacy-conscious) ------------------------------
# e.g. Plausible self-hosted. Leave empty to disable.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=

# --- Audit log (optional) -------------------------------------------------
# Directory for the local JSONL audit log. Defaults to /tmp/sie-audit.
AUDIT_DIR=
